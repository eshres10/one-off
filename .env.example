# Copy to .env.local (Next.js) or .env (scripts). Every value has a safe local default,
# so `npm run local` works without this file. Never commit real secrets.

# --- App ---
APP_URL=http://localhost:3000
LOG_LEVEL=info
# 15% platform commission in basis points
PLATFORM_FEE_BPS=1500
ADMIN_NOTIFICATION_EMAIL=admin@oneoff.test

# --- Database (Supabase Postgres in production; local Postgres for dev/test) ---
# Supabase on Vercel: use the *transaction* pooler (port 6543). Prepared statements are
# switched off automatically for pooler hosts.
DATABASE_URL=postgres://postgres@127.0.0.1:54329/marketplace
# Defaults to 3 on Vercel, 10 elsewhere
# DATABASE_POOL_MAX=10

# --- Auth: local | supabase ---
AUTH_DRIVER=local
# Local driver only: signs session cookies and magic links (32+ chars)
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- Storage: local | supabase ---
STORAGE_DRIVER=local
SUPABASE_STORAGE_BUCKET=marketplace

# --- Payments: mock | stripe ---
PAYMENTS_DRIVER=mock
STRIPE_SECRET_KEY=
# Platform webhook endpoint signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_local_mock_secret
# Connected-accounts webhook endpoint signing secret (whsec_...)
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Email: outbox | resend ---
EMAIL_DRIVER=outbox
RESEND_API_KEY=
EMAIL_FROM="One Off <hello@shoponeoff.com.au>"

# --- Launch mode ---
# Browse-only launch: no bag, checkout or payment webhooks. Works with mock payments,
# local auth and the email outbox in production (requires a real SESSION_SECRET).
PREVIEW_MODE=false
# Pre-launch: the homepage shows the waitlist page (/waitlist). Other pages still work.
WAITLIST_MODE=false

# --- Production safety ---
# Production refuses to start with mock payments/local auth unless this is true (demos, e2e).
ALLOW_LOCAL_DRIVERS_IN_PRODUCTION=false
# Optional error monitoring (see instrumentation.ts / lib/log.ts)
SENTRY_DSN=
# Authorises the daily claims escalation job (Vercel Cron sends it automatically)
CRON_SECRET=
